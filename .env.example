# Copy this file to .env for local development, and add the same values
# as Environment Variables in your Vercel project settings for production.

# Stripe secret key (sk_test_... for testing, sk_live_... for real sales)
STRIPE_SECRET_KEY=

# Optional: a Stripe Price ID (price_...) for the $30 product. If left blank,
# the checkout creates a one-off $30 USD line item automatically.
STRIPE_PRICE_ID=

# Long random string used to sign access cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Optional: lets you (the owner) open the guide without paying, by visiting
#   /api/unlock?preview=<this value>
GUIDE_PREVIEW_SECRET=

# Optional: public URL of the site, e.g. https://amarifitness.com
# If blank, it is derived from the incoming request.
SITE_URL=
